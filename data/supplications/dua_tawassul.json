  "content_item_translations": [
    {
      "sequence_number": 1,
      "language": "en",
      "translation_text": "O Allah, I beseech You and turn my face toward You",
      "transliteration": "allahumma inni as'aluka wa atawajjahu ilayka"
    },
    {
      "sequence_number": 2,
      "language": "en",
      "translation_text": "in the name of Your Prophet; the Prophet of Mercy,",
      "transliteration": "binabiyyika nabiyyi alrrahmati"
    },
    {
      "sequence_number": 3,
      "language": "en",
      "translation_text": "Muhammad—may Allah send blessings to him and his Household.",
      "transliteration": "muhammadin salla allahu `alayhi wa alihi"
    },
    {
      "sequence_number": 4,
      "language": "en",
      "translation_text": "O Abu’l-Qasim!",
      "transliteration": "ya aba alqasimi"
    },
    {
      "sequence_number": 5,
      "language": "en",
      "translation_text": "O Allah’s Messenger!",
      "transliteration": "ya rasula allahi"
    },
    {
      "sequence_number": 6,
      "language": "en",
      "translation_text": "O Chief of Mercy!",
      "transliteration": "ya imama alrrahmati"
    },
    {
      "sequence_number": 7,
      "language": "en",
      "translation_text": "O our master and chief!",
      "transliteration": "ya sayyidana wa mawlana"
    },
    {
      "sequence_number": 8,
      "language": "en",
      "translation_text": "We are turning our faces toward you, seeking your intercession",
      "transliteration": "inna tawajjahana wastashfa`na"
    },
    {
      "sequence_number": 9,
      "language": "en",
      "translation_text": "and your advocacy for us before Allah;",
      "transliteration": "wa tawassalna bika ila allahi"
    },
    {
      "sequence_number": 10,
      "language": "en",
      "translation_text": "and we are presenting you [as our intermediary] for the settlement of our needs.",
      "transliteration": "wa qaddamnaka bayna yaday hajatina"
    },
    {
      "sequence_number": 11,
      "language": "en",
      "translation_text": "O well-esteemed with Allah,",
      "transliteration": "ya wajihan `inda allahi"
    },
    {
      "sequence_number": 12,
      "language": "en",
      "translation_text": "intercede for us before Allah.",
      "transliteration": "ishfa` lana `inda allahi"
    },
    {
      "sequence_number": 13,
      "language": "en",
      "translation_text": "O Abu’l-Hasan!",
      "transliteration": "ya aba alhasani"
    },
    {
      "sequence_number": 14,
      "language": "en",
      "translation_text": "O commander of the Believers!",
      "transliteration": "ya amira almu'minina"
    },
    {
