    },
    {
      "sequence_number": 153,
      "language": "en",
      "translation_text": "O my chiefs and masters!",
      "transliteration": "ya sadati wa mawaliyya"
    },
    {
      "sequence_number": 154,
      "language": "en",
      "translation_text": "I am turning my face toward Allah in the names of you [all],",
      "transliteration": "inni tawajjahtu bikum"
    },
    {
      "sequence_number": 155,
      "language": "en",
      "translation_text": "for you are my leaders and my supporters",
      "transliteration": "a'immati wa `uddati"
    },
    {
      "sequence_number": 156,
      "language": "en",
      "translation_text": "on the day of my destitution and neediness",
      "transliteration": "liyawmi faqri wa hajati"
    },
    {
      "sequence_number": 157,
      "language": "en",
      "translation_text": "before Allah.",
      "transliteration": "ila allahi"
    },
    {
      "sequence_number": 158,
      "language": "en",
      "translation_text": "I am seeking your advocacy for me before Allah",
      "transliteration": "wa tawassaltu bikum ila allahi"
    },
    {
      "sequence_number": 159,
      "language": "en",
      "translation_text": "and seeking your intercession for me before Allah;",
      "transliteration": "wastashfa`tu bikum ila allahi"
    },
    {
      "sequence_number": 160,
      "language": "en",
      "translation_text": "so, (please) intercede for me before Allah",
      "transliteration": "fashfa`u li `inda allahi"
    },
    {
      "sequence_number": 161,
      "language": "en",
      "translation_text": "and save me from my sins before Allah,",
      "transliteration": "wastanqidhuni min dhunubi `inda allahi"
    },
    {
      "sequence_number": 162,
      "language": "en",
      "translation_text": "for you are my means to Allah",
      "transliteration": "fa'innakum wasilati ila allahi"
    },
    {
      "sequence_number": 163,
      "language": "en",
      "translation_text": "and through my love for you and my seeking nearness to you do I hope for salvation from Allah.",
      "transliteration": "wa bihubbikum wa biqurbikum arju najatan mina allahi"
    },
    {
      "sequence_number": 164,
      "language": "en",
      "translation_text": "So, be my hope before Allah.",
      "transliteration": "fakunu `inda allahi raja'i"
    },
    {
      "sequence_number": 165,
      "language": "en",
      "translation_text": "O my masters! O Allah’s intimate servants!",
      "transliteration": "ya sadati ya awliya'a allahi"
    },
    {
      "sequence_number": 166,
      "language": "en",
      "translation_text": "May Allah bless you all",
      "transliteration": "salla allahu `alayhim ajma`ina"
    },
    {
      "sequence_number": 167,
      "language": "en",
      "translation_text": "and may Allah curse the enemies of Allah; those who wronged you,",
      "transliteration": "wa la`ana allahu a`da'a allahi zalimihim"
    },
    {
      "sequence_number": 168,
      "language": "en",
      "translation_text": "from the past and the last generations.",
      "transliteration": "mina al-awwalina wal-akhirina"
    },
    {
      "sequence_number": 169,
      "language": "en",
      "translation_text": "Respond to us, O Lord of the Worlds!",
      "transliteration": "amina rabba al`alamina"
    }
